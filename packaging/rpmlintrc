# rpmlint filters for the conductor-idp packages (packaging/rpmlint.sh runs
# Fedora 44's rpmlint with --strict). Each filter says why it is right here.

# The binary is a static Go program by design: CGO off, built with the
# upstream Go toolchain, one artifact for every supported distribution (the
# same binary as the .deb). No libc to track.
addFilter(r"statically-linked-binary /usr/bin/conductor-idp")
# Not position independent: the Go linker's default executable mode, the
# same binary as the .deb (building with -buildmode=pie is an open decision,
# planning/docs/packaging.md).
addFilter(r"position-independent-executable-suggested /usr/bin/conductor-idp")
# The "conductor-idp" system user and group come from the package's own
# sysusers.d entry (created in %pre); Fedora's registry of standard users
# lists distribution packages only.
addFilter(r"non-standard-(uid|gid) /(etc|var/lib)/conductor-idp")
# Restricted on purpose: the configuration and the TLS directory are for
# root and the conductor-idp group only (the TLS key lives there).
addFilter(r"non-standard-dir-perm /etc/conductor-idp(/tls)? 750")
addFilter(r"non-readable /etc/conductor-idp/idp.toml 640")
# The SELinux scriptlets are Fedora's own %selinux_relabel_pre/_post and
# %selinux_modules_uninstall macros: a copy of the file contexts is taken
# before the module changes and removed after the relabel.
addFilter(r"conductor-idp-selinux\.noarch: E: dangerous-command-in-%(pre|postun) cp")
addFilter(r"conductor-idp-selinux\.noarch: E: dangerous-command-in-%posttrans rm")
