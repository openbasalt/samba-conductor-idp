# Samba Conductor IdP: OpenID Connect provider and SAML 2.0 identity
# provider backed by Samba AD. Runs as the unprivileged "conductor-idp"
# user with no capabilities; it needs only LDAPS and Kerberos to a DC, so
# it may run on a DC or on any other host.
[Unit]
Description=Samba Conductor IdP (OIDC and SAML)
Documentation=https://github.com/openbasalt/samba-conductor-idp/blob/main/docs/install.md
# The AD DC unit (samba-ad-dc on Debian and Ubuntu, samba on Fedora and
# Basalt OS) only matters when the idp runs on a DC (ignored elsewhere).
After=network-online.target samba-ad-dc.service samba.service
Wants=network-online.target

[Service]
Type=simple
User=conductor-idp
Group=conductor-idp
ExecStart=/usr/local/bin/conductor-idp -config /etc/conductor-idp/idp.toml serve
Restart=on-failure
RestartSec=5s

# Secrets reach the service as systemd credentials, readable only by it:
# the master key (seals signing keys and TOTP secrets) and the password of
# the read-only AD service account.
LoadCredential=master-key:/etc/conductor-idp/credentials/master-key
LoadCredential=ad-password:/etc/conductor-idp/credentials/ad-password

StateDirectory=conductor-idp
StateDirectoryMode=0700
UMask=0077

# Sandbox.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
ReadOnlyPaths=/etc/conductor-idp
InaccessiblePaths=-/etc/conductor-idp/credentials
DevicePolicy=closed
# With mfa.backend = "conductor", allow conductor's verification socket:
# ReadWritePaths=/run/conductor

[Install]
WantedBy=multi-user.target
