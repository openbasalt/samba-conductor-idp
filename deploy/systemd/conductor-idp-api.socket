# The management API socket of conductor-idp (conductor's "Single sign-on"
# section). systemd creates it owned by the conductor-idp user and the
# conductor group, mode 0660, and hands it to conductor-idp.service;
# conductor-idp additionally admits only the conductor user (SO_PEERCRED).
# Enable it together with [api] enabled = true in idp.toml.
[Unit]
Description=conductor-idp management API socket
Documentation=https://github.com/openbasalt/samba-conductor-idp/blob/main/docs/install.md

[Socket]
ListenStream=/run/conductor-idp/api.sock
SocketUser=conductor-idp
SocketGroup=conductor
SocketMode=0660
DirectoryMode=0755
Accept=no
Service=conductor-idp.service

[Install]
WantedBy=sockets.target
