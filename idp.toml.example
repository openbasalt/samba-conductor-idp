# Samba Conductor IdP configuration (/etc/conductor-idp/idp.toml).
# Reference: docs/config.md. Unknown keys are rejected, so a typo never
# silently falls back to a default.

[server]
# Public base URL: the OIDC issuer and the base of every SAML URL.
# https only, no path. Relying parties pin it; changing it breaks them.
issuer = "https://idp.example.com"
# Built-in TLS (the key must be readable by the conductor-idp user).
listen = ":9443"
tls_cert = "/etc/conductor-idp/tls/cert.pem"
tls_key = "/etc/conductor-idp/tls/key.pem"
# Or behind a TLS reverse proxy on the same host (loopback only):
# listen = "127.0.0.1:9080"
# behind_proxy = true
# trusted_proxies = ["127.0.0.1/32", "::1/128"]

# Admin pages (/admin). Unset: served on the listener above, as before.
# For an IdP reachable from the internet, give them a listener of their own
# on an internal or VPN address; the listener above then answers 404 for
# every admin path and accepts no administrator enrollment link.
# admin_listen = "10.0.0.5:9444"
# "off": no admin pages at all (manage clients with the CLI or conductor).
# admin_listen = "off"
# Its certificate (default: tls_cert and tls_key above).
# admin_tls_cert = "/etc/conductor-idp/tls/admin-cert.pem"
# admin_tls_key = "/etc/conductor-idp/tls/admin-key.pem"
# Its external base URL, used in enrollment links. When set, the admin
# listener answers only for this host name. Default: the issuer's host
# name with admin_listen's port.
# admin_url = "https://idp-admin.example.com:9444"
# Or behind a TLS reverse proxy on the same host (loopback only;
# admin_url is then required):
# admin_listen = "127.0.0.1:9081"
# admin_behind_proxy = true
# admin_trusted_proxies = ["127.0.0.1/32", "::1/128"]

[domain]
realm = "EXAMPLE.COM"
# The CA that signs the DCs' LDAPS certificates; nothing else is trusted.
ca_file = "/etc/conductor-idp/domain-ca.pem"
# Empty dcs = discover DCs through DNS SRV records.
preferred = ["dc1.example.com"]
dcs = []
dns_servers = []
# Verify passwords with an LDAP simple bind over TLS when no KDC answers.
simple_bind_fallback = false

[service_account]
# A plain domain user with no group memberships beyond Domain Users: it
# only reads users and groups. Its password comes from the systemd
# credential "ad-password" (or password_file).
username = "svc-conductor-idp"
password_file = ""

[roles]
# Who may use the admin pages: AD group SIDs. Empty = Domain Admins.
admin_groups = []
cache_seconds = 60

[mfa]
# Second factor for users who are not administrators: off, optional or
# required. Administrators always need it. Clients and SAML apps can
# require it too.
policy = "optional"
# "local": the idp keeps its own TOTP enrollments. "conductor": one 2FA
# for both (TOTP, recovery codes, security keys and conductor's policy)
# through conductor's local socket (same host, conductor-mfa.socket).
backend = "local"
# conductor_socket = "/run/conductor/mfa.sock"
admin_enrollment_requires_link = true
issuer = "Samba Conductor IdP"

[keys]
# Empty: $CREDENTIALS_DIRECTORY/master-key (systemd LoadCredential).
master_key_file = ""
# OIDC signing keys rotate after rotate_days; replaced keys stay
# published for overlap_hours (also the SAML staged-rotation overlap).
rotate_days = 90
overlap_hours = 48

[tokens]
id_token_minutes = 5
access_token_minutes = 10
refresh_token_hours = 720   # absolute lifetime of a refresh chain (30 days)
refresh_idle_hours = 168    # a refresh token unused for 7 days expires

[session]
# The idp's single sign-on session.
idle_minutes = 60
absolute_hours = 8

[ratelimit]
per_ip_per_minute = 30
account_failures = 5          # keep below the domain's lockout threshold
account_window_minutes = 15
token_per_ip_per_minute = 120

[state]
database = "/var/lib/conductor-idp/idp.db"

[ui]
default_language = "en"   # or "pt-BR"
product_name = "Samba Conductor"

[saml]
enabled = true
assertion_minutes = 5

[api]
# The management API for conductor's "Single sign-on" section (clients,
# SAML service providers, keys, settings, activity). Enable it together
# with conductor-idp-api.socket; only the conductor user may connect.
enabled = false
# socket = "/run/conductor-idp/api.sock"   # used when systemd passes no socket
# socket_group = "conductor"               # group of a socket the service creates
# allowed_users = ["conductor"]
